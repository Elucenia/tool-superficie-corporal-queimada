        "https://doi.org/10.1016/j.burns.2012.08.016"
      ],
      [
        "ISBI2016 original guideline content hosted by burn society",
        "https://saburnsociety.co.za/wp-content/uploads/2020/11/ISBI-Guideline-July-2017.pdf"
      ],
      [
        "ABA current referral guidance,retrieved2026-10-04",
        "https://www.ameriburn.org/burn-care-team/resources/guidelines-for-burn-patient-referral"
      ]
    ],
